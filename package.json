{
  "name": "ac-track-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build Assetto Corsa tracks from real-world roads in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
